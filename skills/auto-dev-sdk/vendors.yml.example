# vendors.yml — default harness vendor configuration for auto-dev-sdk.
#
# Copy this to the auto-dev-sdk root as `vendors.yml` for the default harness
# config, or pass a copy with `--vendors-yml` / `AUTODEV_VENDORS_YML`.
# Target repos should not need their own vendor config unless they
# intentionally override harness defaults.
#
# Required: `stages` mapping with every coding stage below.
# Allowed coding vendors: claude, codex, openai. Agy is panel-review-only.
# Vendor labels are case-insensitive and normalized to lowercase.
# `codex` and `openai` both route through the Codex CLI.
# `probe_interval_sec` is the stream-output idle threshold for the
# probe LLM: when the vendor output file has been silent for this many
# seconds, the harness asks the probe to extend or kill. The hard
# wall-clock backstop is derived in subprocess_runner.
# `effort` uses the shared scale min|low|medium|high|xhigh|max; shared/vendors
# maps it to the nearest supported native effort for the selected vendor.
# `flags` is optional and restricted by autodev/vendors/allowlist.py.
# Harness-owned write/approval scope controls such as yolo, tool allowlists,
# and extra write directories are intentionally not configurable here.
# All LLM calls route through the packaged shared/vendors module and its
# `<id>/out`, `<id>/status`, `<id>/log` contract.
#
# QUOTA GATE + FALLBACKS (optional; any role: stages, panel reviewers,
# synthesizer, probe):
#   min_quota_pct: minimum *remaining* quota % required to run this LLM. Before
#     each call the harness reads the vendor's remaining quota. Agy has no
#     machine-readable quota command, so quota-gated Agy candidates fail
#     closed. If remaining < min_quota_pct, the next fallback is tried.
#     Omit = ungated.
#   fallbacks: ordered alternates, each a full LLM (vendor/model/effort) with its
#     own min_quota_pct. The first with enough quota is used. If NONE qualify the
#     run pauses (GATE_PENDING) and records the earliest recovery time + a repo
#     fingerprint; `autodev quota-resume <feature>` then auto-continues only if
#     still paused, time reached, quota recovered, and the repo is unchanged.
#   Fail-closed: a vendor whose quota can't be read counts as insufficient.
#   Constraints: stage/probe fallback vendors ∈ the role's allowed set; reviewer
#     fallbacks must use a different underlying provider than their primary;
#     synthesizer fallbacks must be schema-capable (claude/codex/openai). codex
#     `credits` remaining is coarse (binary), so its rate-limit windows drive %.

stages:
  design:
    vendor: codex
    model: gpt-5.5
    probe_interval_sec: 1200
    effort: max
    # Example quota gate: prefer codex while it has >=20% of its window left;
    # otherwise fall back to claude (>=15%), then cursor (>=10%).
    min_quota_pct: 20
    fallbacks:
      - vendor: claude
        model: claude-opus-4-8
        effort: max
        min_quota_pct: 15
      - vendor: cursor
        model: gpt-5.5-extra-high
        effort: max
        min_quota_pct: 10

  build:
    vendor: codex
    model: gpt-5.4
    probe_interval_sec: 3600
    effort: high

  spec:
    vendor: codex
    model: gpt-5.4
    probe_interval_sec: 900
    effort: high

  review:
    vendor: codex
    model: gpt-5.4
    probe_interval_sec: 900
    effort: high

panel:
  reviewers:
    - vendor: claude
      model: claude-sonnet-4-6
      effort: high
    - vendor: agy
      effort: high
    - vendor: codex
      model: gpt-5.4
      effort: high
  synthesizer:
    vendor: claude
    model: claude-sonnet-4-6
    effort: high
  reviewer_probe_interval_sec: 600
  synthesizer_probe_interval_sec: 300

probe:
  vendor: claude
  model: claude-sonnet-4-6
  timeout_sec: 60
  effort: low

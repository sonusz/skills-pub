# vendors.yml — default harness vendor configuration for auto-dev-sdk.
#
# Copy this to the auto-dev-sdk root as `vendors.yml` for the default harness
# config, or pass a copy with `--vendors-yml` / `AUTODEV_VENDORS_YML`.
# Target repos should not need their own vendor config unless they
# intentionally override harness defaults.
#
# Required: `stages` mapping with every coding stage below.
# Allowed coding vendors: claude, codex, openai. Gemini is panel-review-only.
# Vendor labels are case-insensitive and normalized to lowercase.
# `codex` and `openai` both route through the Codex CLI.
# `probe_interval_sec` is the stream-output idle threshold for the
# probe LLM: when the vendor output file has been silent for this many
# seconds, the harness asks the probe to extend or kill. The hard
# wall-clock backstop is derived in subprocess_runner.
# `effort` uses the shared scale min|low|medium|high|xhigh|max; shared/vendors
# maps it to the nearest supported native effort for the selected vendor.
# `flags` is optional and restricted by autodev/vendors/allowlist.py.
# Harness-owned write/approval scope controls such as yolo, tool allowlists,
# and extra write directories are intentionally not configurable here.
# All LLM calls route through the packaged shared/vendors module and its
# `<id>/out`, `<id>/status`, `<id>/log` contract.

stages:
  design:
    vendor: codex
    model: gpt-5.5
    probe_interval_sec: 1200
    effort: max

  build:
    vendor: codex
    model: gpt-5.4
    probe_interval_sec: 3600
    effort: high

  spec:
    vendor: codex
    model: gpt-5.4
    probe_interval_sec: 900
    effort: high

  review:
    vendor: codex
    model: gpt-5.4
    probe_interval_sec: 900
    effort: high

panel:
  reviewers:
    - vendor: claude
      model: claude-sonnet-4-6
      effort: high
    - vendor: gemini
      model: gemini-3-flash-preview
      effort: high
    - vendor: codex
      model: gpt-5.4
      effort: high
  synthesizer:
    vendor: claude
    model: claude-sonnet-4-6
    effort: high
  reviewer_probe_interval_sec: 600
  synthesizer_probe_interval_sec: 300

probe:
  vendor: claude
  model: claude-sonnet-4-6
  timeout_sec: 60
  effort: low

# vendors.yml schema for autodev v2.
#
# Required: `stages` mapping. Every coding stage (scope/plan/build/spec/review)
# must be declared. vendor ∈ {claude, codex} only (gemini is panel-review-only).
#
# `timeout_sec` is optional; default 1800s.
# `flags` is optional; limited to a per-vendor allowlist of restrictive options
# (see `autodev/vendors/allowlist.py`). Harness-owned write-scope flags
# (`--allowedTools`, `--add-dir`) are NOT configurable here.

stages:
  scope:
    vendor: claude
    model: claude-sonnet-4-6
    timeout_sec: 900
    # flags: ["--effort", "high"]          # allowed (monotone)
    # flags: ["--allowedTools", "Bash"]    # REJECTED (harness-owned)

  plan:
    vendor: codex
    model: gpt-5.4
    timeout_sec: 1200

  build:
    vendor: claude
    model: claude-sonnet-4-6
    timeout_sec: 3600
    flags: ["--effort", "high"]

  spec:
    vendor: codex
    model: gpt-5.4
    timeout_sec: 900

  review:
    vendor: claude
    model: claude-sonnet-4-6
    timeout_sec: 900

# Panel-review stages (prd-review, architecture-review, close-approval)
# are NOT configured here — the panel-review skill's own models.conf
# owns vendor selection for those gates.
